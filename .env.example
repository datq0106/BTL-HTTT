# Sao chép thành .env rồi điền giá trị. Không commit file .env.
# Tạo chuỗi ngẫu nhiên: openssl rand -hex 24

# ===== Bắt buộc =====
# Mật khẩu MySQL cho user ứng dụng và root (không dùng lại cho nơi khác).
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
# Mật khẩu ban đầu của tài khoản "admin" (ít nhất 12 ký tự). Chỉ dùng khi database
# chưa có admin; sau khi tạo, đổi mật khẩu trên giao diện, sửa giá trị này không có tác dụng.
APP_ADMIN_PASSWORD=replace-with-a-unique-admin-password

# ===== Cổng truy cập =====
# Server chạy HTTP trực tiếp: giữ APP_BIND=0.0.0.0, APP_PORT=80 (hoặc cổng khác đã mở firewall).
# Dùng profile https (Caddy chiếm 80/443): đặt APP_BIND=127.0.0.1 và APP_PORT=8088.
APP_BIND=0.0.0.0
APP_PORT=80

# ===== HTTPS (tùy chọn) =====
# Tên miền trỏ về server, chạy: docker compose --profile https up -d --build
DOMAIN=

# ===== Giới hạn bộ nhớ (server nhỏ có thể giảm, tổng nên < RAM máy) =====
DB_MEM_LIMIT=1g
BACKEND_MEM_LIMIT=768m
